#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["pillow"]
# ///
"""Prepare GIFs for the Kublet and keep them in a library directory.

The device decodes a GIF from RAM, so every file must be 240x240 and small.
This tool converts source media to that format, extracts GIFs that apps embed
as C arrays, and draws the mascot set.

Commands:
  pack <input> <name>      Convert an image, GIF, or video into the library
  extract <header.h> <name>  Recover a GIF that an app embeds as a C array
  mascot                   Draw the mascot animation set into the library
  list                     Show what the library holds

The library lives at ~/code/gifs, or wherever GIF_LIBRARY points.
"""

import argparse
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

from PIL import Image, ImageDraw, ImageSequence

# The device holds the whole GIF in RAM while it plays, next to WiFi and the
# display driver. Keep files well under the free heap.
SIZE = 240
# The device buffers the whole GIF in heap. Its limit is 96 KB, set by the
# largest contiguous block malloc can return once WiFi and the display are up.
DEFAULT_MAX_KB = 94
DEFAULT_FPS = 12

LIBRARY = Path(os.environ.get("GIF_LIBRARY", Path.home() / "code" / "gifs"))

# The mascot is a blocky character built from rectangles, in terracotta.
CLAY = (221, 119, 91)
CLAY_LIGHT = (240, 152, 122)
CLAY_DARK = (186, 94, 70)
AMBER = (232, 168, 70)
EYE = (28, 18, 14)
BG = (13, 13, 16)


# ---------------------------------------------------------------------------
# Library helpers
# ---------------------------------------------------------------------------
def library_path(name: str) -> Path:
    """Return the library path for a name, adding the .gif suffix."""
    LIBRARY.mkdir(parents=True, exist_ok=True)
    stem = name[:-4] if name.lower().endswith(".gif") else name
    return LIBRARY / f"{stem}.gif"


def save_frames(frames: list[Image.Image], out: Path, fps: int, max_kb: int) -> None:
    """Write frames as a GIF, reducing colours and frames until it fits."""
    duration = max(20, int(1000 / fps))

    # Smoothness matters more than colour depth on a 240x240 panel, so spend
    # colours first and only drop frames when even 32 colours will not fit.
    for drop in (1, 2, 3, 4, 6, 8, 12, 16, 24, 32):
        for colors in (256, 128, 64, 32, 16, 12, 8):
            picked = frames[::drop]
            if len(picked) < 2:
                continue
            # One shared palette, and every frame written whole. Partial frames
            # rely on GIF disposal, and the device's decoder paints those
            # regions with the background colour when the animation loops.
            # No dithering. Dither noise breaks up flat areas, which costs far
            # more in LZW size than the extra colours are worth: with dithering
            # this clip needed 122 KB for 9 frames, without it 90 KB.
            first = picked[0].convert("RGB").quantize(
                colors=colors, method=Image.MEDIANCUT, dither=Image.Dither.NONE
            )
            quantized = [first] + [
                f.convert("RGB").quantize(palette=first, dither=Image.Dither.NONE)
                for f in picked[1:]
            ]

            # Some sources carry a transparency entry that survives the convert
            # and quantize steps as an RGB tuple, which Pillow cannot write back
            # into a GIF. The frames are opaque here, so drop it.
            for frame in quantized:
                frame.info.pop("transparency", None)
                frame.info.pop("background", None)
            quantized[0].save(
                out,
                save_all=True,
                append_images=quantized[1:],
                duration=duration * drop,
                loop=0,
                optimize=False,
                disposal=1,
            )
            size_kb = out.stat().st_size / 1024
            if size_kb <= max_kb:
                effective_fps = fps / drop
                print(
                    f"  {out.name}: {len(picked)} frames, {colors} colors, "
                    f"{size_kb:.0f} KB, {effective_fps:.1f} fps"
                )
                if drop > 1 or colors < 256:
                    print(
                        f"    (dropped to fit {max_kb} KB: kept 1 frame in {drop}, "
                        f"{colors} colors)"
                    )
                return

    size_kb = out.stat().st_size / 1024
    print(f"  ! {out.name} is {size_kb:.0f} KB, above the {max_kb} KB limit")
    print("    Shorten it, or lower the frame rate.")


def fit_square(frame: Image.Image) -> Image.Image:
    """Centre-crop to a square, then resize to the display size."""
    w, h = frame.size
    side = min(w, h)
    left = (w - side) // 2
    top = (h - side) // 2
    cropped = frame.crop((left, top, left + side, top + side))
    return cropped.resize((SIZE, SIZE), Image.LANCZOS)


# ---------------------------------------------------------------------------
# pack
# ---------------------------------------------------------------------------
def load_video_frames(src: Path, start: float, seconds: float, fps: int) -> list:
    """Pull frames out of a video with ffmpeg."""
    if not shutil.which("ffmpeg"):
        print("Error: ffmpeg is not installed. Run: brew install ffmpeg")
        sys.exit(1)

    with tempfile.TemporaryDirectory() as tmp:
        cmd = ["ffmpeg", "-y", "-v", "error"]
        if start:
            cmd += ["-ss", str(start)]
        cmd += ["-i", str(src)]
        if seconds:
            cmd += ["-t", str(seconds)]
        cmd += ["-vf", f"fps={fps}", str(Path(tmp) / "f%04d.png")]

        result = subprocess.run(cmd)
        if result.returncode != 0:
            print("Error: ffmpeg could not read that file.")
            sys.exit(1)

        files = sorted(Path(tmp).glob("f*.png"))
        return [Image.open(f).convert("RGB").copy() for f in files]


def cmd_pack(args: argparse.Namespace) -> None:
    """Convert an image, GIF, or video into the library."""
    src = Path(args.input).expanduser()
    if not src.exists():
        print(f"Error: {src} does not exist.")
        sys.exit(1)

    video_suffixes = {".mp4", ".mov", ".m4v", ".webm", ".mkv", ".avi"}
    if src.suffix.lower() in video_suffixes:
        frames = load_video_frames(src, args.start, args.seconds, args.fps)
    else:
        image = Image.open(src)
        frames = []
        starts = []  # when each frame appears, in seconds
        clock = 0.0
        for frame in ImageSequence.Iterator(image):
            frames.append(frame.convert("RGB").copy())
            starts.append(clock)
            clock += frame.info.get("duration", 100) / 1000.0

        if args.start or args.seconds:
            until = args.start + args.seconds if args.seconds else clock
            kept = [
                f for f, at in zip(frames, starts) if args.start <= at < until
            ]
            if kept:
                print(
                    f"  Trimmed to {args.start:g}s..{until:g}s "
                    f"({len(kept)} of {len(frames)} frames)"
                )
                starts = [
                    at - args.start for at in starts if args.start <= at < until
                ]
                frames = kept
            else:
                print(f"  ! nothing between {args.start:g}s and {until:g}s")
                sys.exit(1)

        # Resample to the requested rate. Without this the source rate is kept
        # and the size search thins the frames instead, which slows playback.
        span = args.seconds if args.seconds else clock - args.start
        if span > 0 and len(frames) > 1:
            wanted = max(2, int(round(span * args.fps)))
            if wanted < len(frames):
                picked = []
                for i in range(wanted):
                    target = i * span / wanted
                    nearest = min(range(len(starts)), key=lambda j: abs(starts[j] - target))
                    picked.append(frames[nearest])
                print(f"  Resampled {len(frames)} frames to {len(picked)} at {args.fps} fps")
                frames = picked

    if not frames:
        print("Error: no frames found in that file.")
        sys.exit(1)

    frames = [fit_square(f) for f in frames]
    out = library_path(args.name)
    print(f"Packing {src.name} -> {out}")
    save_frames(frames, out, args.fps, args.max_kb)


# ---------------------------------------------------------------------------
# extract
# ---------------------------------------------------------------------------
def cmd_extract(args: argparse.Namespace) -> None:
    """Recover a GIF that an app embeds as a C byte array."""
    src = Path(args.header).expanduser()
    if not src.exists():
        print(f"Error: {src} does not exist.")
        sys.exit(1)

    text = src.read_text()
    body = text[text.index("{") + 1 : text.rindex("}")]
    data = bytes(int(b, 16) for b in re.findall(r"0x([0-9a-fA-F]{2})", body))

    if not data.startswith(b"GIF8"):
        print("Error: that header does not hold GIF data.")
        sys.exit(1)

    out = library_path(args.name)
    out.write_bytes(data)
    print(f"Extracted {out} ({len(data) / 1024:.0f} KB)")

    with Image.open(out) as image:
        print(f"  {image.size[0]}x{image.size[1]}, {image.n_frames} frames")
        if image.size != (SIZE, SIZE):
            print(f"  ! not {SIZE}x{SIZE} — run 'gifpack pack' on it")
    if len(data) / 1024 > args.max_kb:
        print(f"  ! {len(data) / 1024:.0f} KB is above the {args.max_kb} KB limit")
        print(f"    Repack it: ./tools/gifpack pack {out} {args.name}")


# ---------------------------------------------------------------------------
# mascot
# ---------------------------------------------------------------------------
def draw_mascot(
    draw: ImageDraw.ImageDraw,
    cx: float,
    body_top: float,
    leg_phase: float = 0.0,
    hand_left: float = 0.0,
    hand_right: float = 0.0,
    eye_shift: float = 0.0,
    lean: float = 0.0,
    body_color: tuple = CLAY,
) -> None:
    """Draw the mascot. Every part is a rectangle, which is how it is built.

    body_top is the y of the body block. leg_phase drives the walk cycle, and
    hand_left and hand_right lift each hand in pixels.
    """
    body_w, body_h = 112, 82
    bx = cx - body_w / 2 + lean
    by = body_top

    # Legs first, so the body block overlaps their tops.
    leg_w, leg_h = 17, 38
    gap = (body_w - 4 * leg_w) / 3
    for i in range(4):
        lift = max(0.0, math.sin(leg_phase + i * math.pi / 2)) * 11
        lx = bx + i * (leg_w + gap)
        top = by + body_h - 4
        draw.rectangle([lx, top, lx + leg_w, top + leg_h - lift], fill=CLAY_DARK)

    # Hands, one block each side.
    hand_w, hand_h = 20, 30
    hy = by + 30
    draw.rectangle(
        [bx - hand_w - 6, hy - hand_left, bx - 6, hy + hand_h - hand_left],
        fill=CLAY_DARK,
    )
    draw.rectangle(
        [
            bx + body_w + 6,
            hy - hand_right,
            bx + body_w + 6 + hand_w,
            hy + hand_h - hand_right,
        ],
        fill=CLAY_DARK,
    )

    # Body block.
    draw.rectangle([bx, by, bx + body_w, by + body_h], fill=body_color)

    # Eyes shift position rather than change shape.
    eye_w, eye_h = 15, 22
    ey = by + 26
    left = bx + 24 + eye_shift
    right = bx + body_w - 24 - eye_w + eye_shift
    draw.rectangle([left, ey, left + eye_w, ey + eye_h], fill=EYE)
    draw.rectangle([right, ey, right + eye_w, ey + eye_h], fill=EYE)


def new_frame() -> tuple:
    """Return a blank frame and its drawing context."""
    frame = Image.new("RGB", (SIZE, SIZE), BG)
    return frame, ImageDraw.Draw(frame)


def make_hello() -> list:
    """The mascot bobs and waves one hand."""
    frames = []
    for i in range(24):
        t = i / 24
        frame, draw = new_frame()
        wave = max(0.0, math.sin(t * 4 * math.pi)) * 26
        draw_mascot(
            draw,
            SIZE / 2,
            84 + math.sin(t * 2 * math.pi) * 5,
            hand_right=wave,
            eye_shift=math.sin(t * 2 * math.pi) * 4,
        )
        frames.append(frame)
    return frames


def make_walk() -> list:
    """A walk cycle in place."""
    frames = []
    for i in range(20):
        t = i / 20
        frame, draw = new_frame()
        draw_mascot(
            draw,
            SIZE / 2,
            86 + abs(math.sin(t * 2 * math.pi)) * 6,
            leg_phase=t * 2 * math.pi,
            hand_left=math.sin(t * 2 * math.pi) * 8,
            hand_right=-math.sin(t * 2 * math.pi) * 8,
            eye_shift=3,
        )
        frames.append(frame)
    return frames


def make_thinking() -> list:
    """The mascot looks around while it waits."""
    frames = []
    for i in range(24):
        t = i / 24
        frame, draw = new_frame()
        look = math.sin(t * 2 * math.pi) * 7
        draw_mascot(
            draw,
            SIZE / 2,
            88 + math.sin(t * 4 * math.pi) * 2,
            hand_left=14 if i % 12 < 6 else 10,
            eye_shift=look,
            lean=look * 0.5,
        )
        # three blocks that fill up, one per beat
        for d in range(3):
            lit = (i // 4) % 3 == d
            x = SIZE / 2 - 34 + d * 26
            y = 204
            size = 14 if lit else 9
            color = CLAY_LIGHT if lit else CLAY_DARK
            draw.rectangle([x, y, x + size, y + size], fill=color)
        frames.append(frame)
    return frames


def make_done() -> list:
    """The mascot hops, and a blocky tick builds itself."""
    frames = []
    # stair-stepped tick, drawn as blocks to match the mascot
    steps = [(96, 176), (106, 186), (116, 196), (126, 186), (136, 176), (146, 166)]
    for i in range(24):
        t = i / 24
        frame, draw = new_frame()
        hop = -18 * max(0.0, math.sin(min(t * 2.0, 1.0) * math.pi))
        draw_mascot(draw, SIZE / 2, 62 + hop, hand_left=12, hand_right=12)

        shown = int(max(0.0, (t - 0.3) / 0.45) * len(steps))
        for x, y in steps[: min(shown, len(steps))]:
            draw.rectangle([x, y, x + 12, y + 12], fill=(120, 214, 140))
        frames.append(frame)
    return frames


def make_oops() -> list:
    """The mascot shakes and turns amber."""
    frames = []
    for i in range(20):
        t = i / 20
        frame, draw = new_frame()
        shake = math.sin(t * 8 * math.pi) * 11
        draw_mascot(
            draw,
            SIZE / 2 + shake,
            88,
            hand_left=-6,
            hand_right=-6,
            eye_shift=-shake * 0.4,
            body_color=AMBER,
        )
        frames.append(frame)
    return frames


def make_celebrate() -> list:
    """The mascot bounces while confetti blocks fall."""
    frames = []
    confetti = [
        (18 + (k * 37) % 210, (k * 53) % 240, k % 4) for k in range(22)
    ]
    palette = [CLAY_LIGHT, AMBER, (120, 214, 140), (240, 240, 240)]
    for i in range(24):
        t = i / 24
        frame, draw = new_frame()
        for x, y0, tone in confetti:
            y = (y0 + t * 240) % 260 - 10
            size = 7 + (tone % 2) * 4
            draw.rectangle([x, y, x + size, y + size], fill=palette[tone])
        bounce = -16 * abs(math.sin(t * 2 * math.pi))
        draw_mascot(
            draw,
            SIZE / 2,
            86 + bounce,
            hand_left=20 + bounce,
            hand_right=20 + bounce,
            leg_phase=t * 4 * math.pi,
        )
        frames.append(frame)
    return frames


MASCOTS = {
    "hello": make_hello,
    "walk": make_walk,
    "thinking": make_thinking,
    "done": make_done,
    "oops": make_oops,
    "celebrate": make_celebrate,
}


def cmd_mascot(args: argparse.Namespace) -> None:
    """Draw the mascot set into the library."""
    names = args.only or list(MASCOTS)
    print(f"Drawing mascot animations into {LIBRARY}")
    for name in names:
        if name not in MASCOTS:
            print(f"  ! unknown mascot '{name}'")
            continue
        frames = MASCOTS[name]()
        save_frames(frames, library_path(name), args.fps, args.max_kb)


# ---------------------------------------------------------------------------
# list
# ---------------------------------------------------------------------------
def cmd_list(_args: argparse.Namespace) -> None:
    """Show what the library holds."""
    if not LIBRARY.exists():
        print(f"No library at {LIBRARY}. Run './tools/gifpack mascot' to start one.")
        return

    files = sorted(LIBRARY.glob("*.gif"))
    if not files:
        print(f"{LIBRARY} holds no GIFs.")
        return

    print(f"{LIBRARY}:")
    for path in files:
        size_kb = path.stat().st_size / 1024
        try:
            with Image.open(path) as image:
                detail = f"{image.size[0]}x{image.size[1]}, {image.n_frames} frames"
        except OSError:
            detail = "unreadable"
        flag = "  ok" if size_kb <= DEFAULT_MAX_KB else "  TOO BIG"
        print(f"  {path.stem:<16} {size_kb:>6.0f} KB  {detail}{flag}")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def main() -> None:
    parser = argparse.ArgumentParser(
        prog="gifpack",
        description="Prepare GIFs for the Kublet and keep them in a library.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
examples:
  ./tools/gifpack mascot
  ./tools/gifpack pack clip.mp4 wave --start 91 --seconds 20
  ./tools/gifpack extract apps/badgers/src/badgers.h badgers
  ./tools/gifpack list
        """,
    )
    parser.add_argument(
        "--max-kb",
        type=int,
        default=DEFAULT_MAX_KB,
        help=f"Size limit in KB (default: {DEFAULT_MAX_KB})",
    )
    parser.add_argument(
        "--fps", type=int, default=DEFAULT_FPS, help=f"Default: {DEFAULT_FPS}"
    )
    subparsers = parser.add_subparsers(dest="command", title="commands")

    p_pack = subparsers.add_parser("pack", help="Convert media into the library")
    p_pack.add_argument("input", help="Image, GIF, or video file")
    p_pack.add_argument("name", help="Library name, for example wave")
    p_pack.add_argument(
        "--start", type=float, default=0.0, help="Video start time in seconds"
    )
    p_pack.add_argument(
        "--seconds", type=float, default=0.0, help="Length to take from a video"
    )

    p_extract = subparsers.add_parser(
        "extract", help="Recover a GIF from an app's C array"
    )
    p_extract.add_argument("header", help="Path to the .h file")
    p_extract.add_argument("name", help="Library name")

    p_mascot = subparsers.add_parser("mascot", help="Draw the mascot set")
    p_mascot.add_argument(
        "only", nargs="*", help=f"Which ones to draw ({', '.join(MASCOTS)})"
    )

    subparsers.add_parser("list", help="Show what the library holds")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)

    commands = {
        "pack": cmd_pack,
        "extract": cmd_extract,
        "mascot": cmd_mascot,
        "list": cmd_list,
    }
    commands[args.command](args)


main()

#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["pillow"]
# ///
"""Prepare GIFs for the Kublet and keep them in a library directory.

The device decodes a GIF from RAM, so every file must be 240x240 and small.
This tool converts source media to that format, extracts GIFs that apps embed
as C arrays, and draws the mascot set.

Commands:
  pack <input> <name>      Convert an image, GIF, or video into the library
  extract <header.h> <name>  Recover a GIF that an app embeds as a C array
  mascot                   Draw the mascot animation set into the library
  list                     Show what the library holds

The library lives at ~/code/gifs, or wherever GIF_LIBRARY points.
"""

import argparse
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

from PIL import Image, ImageDraw, ImageSequence

# The device holds the whole GIF in RAM while it plays, next to WiFi and the
# display driver. Keep files well under the free heap.
SIZE = 240
# The device buffers the whole GIF in heap. Its limit is 96 KB, set by the
# largest contiguous block malloc can return once WiFi and the display are up.
DEFAULT_MAX_KB = 94
DEFAULT_FPS = 12

LIBRARY = Path(os.environ.get("GIF_LIBRARY", Path.home() / "code" / "gifs"))

# The mascot is a blocky character built from rectangles, in terracotta.
CLAY = (221, 119, 91)
CLAY_LIGHT = (240, 152, 122)
CLAY_DARK = (186, 94, 70)
AMBER = (232, 168, 70)
EYE = (28, 18, 14)
BG = (13, 13, 16)


# ---------------------------------------------------------------------------
# Library helpers
# ---------------------------------------------------------------------------
def library_path(name: str) -> Path:
    """Return the library path for a name, adding the .gif suffix."""
    LIBRARY.mkdir(parents=True, exist_ok=True)
    stem = name[:-4] if name.lower().endswith(".gif") else name
    return LIBRARY / f"{stem}.gif"


def save_frames(frames: list[Image.Image], out: Path, fps: int, max_kb: int) -> None:
    """Write frames as a GIF, reducing colours and frames until it fits."""
    duration = max(20, int(1000 / fps))

    # Smoothness matters more than colour depth on a 240x240 panel, so spend
    # colours first and only drop frames when even 32 colours will not fit.
    for drop in (1, 2, 3, 4, 6, 8, 12, 16, 24, 32):
        for colors in (256, 128, 64, 32, 16, 12, 8):
            picked = frames[::drop]
            if len(picked) < 2:
                continue
            # One shared palette, and every frame written whole. Partial frames
            # rely on GIF disposal, and the device's decoder paints those
            # regions with the background colour when the animation loops.
            # No dithering. Dither noise breaks up flat areas, which costs far
            # more in LZW size than the extra colours are worth: with dithering
            # this clip needed 122 KB for 9 frames, without it 90 KB.
            # FASTOCTREE, not MEDIANCUT. Median cut assigns palette entries by
            # how many pixels hold a colour, so small details are merged into
            # the bulk of the image: at 12 colours the mascot's black eyes
            # vanished into its body, because they are only a few pixels.
            # Max coverage keeps them but tints the background, because it
            # spreads entries across the colour space. The octree keeps both.
            reference = picked[0].convert("RGB").quantize(
                colors=colors, method=Image.FASTOCTREE, dither=Image.Dither.NONE
            )
            # Map every frame through the palette, the first one included.
            # Quantizing frame 0 directly and matching the rest against its
            # palette uses two different mappings, and they disagree: the
            # ground came out as background in frame 0 alone, which flashed
            # once per loop.
            quantized = [
                f.convert("RGB").quantize(palette=reference, dither=Image.Dither.NONE)
                for f in picked
            ]

            # Some sources carry a transparency entry that survives the convert
            # and quantize steps as an RGB tuple, which Pillow cannot write back
            # into a GIF. The frames are opaque here, so drop it.
            for frame in quantized:
                frame.info.pop("transparency", None)
                frame.info.pop("background", None)
            quantized[0].save(
                out,
                save_all=True,
                append_images=quantized[1:],
                duration=duration * drop,
                loop=0,
                optimize=False,
                disposal=1,
            )
            size_kb = out.stat().st_size / 1024
            if size_kb <= max_kb:
                effective_fps = fps / drop
                print(
                    f"  {out.name}: {len(picked)} frames, {colors} colors, "
                    f"{size_kb:.0f} KB, {effective_fps:.1f} fps"
                )
                if drop > 1 or colors < 256:
                    print(
                        f"    (dropped to fit {max_kb} KB: kept 1 frame in {drop}, "
                        f"{colors} colors)"
                    )
                return

    size_kb = out.stat().st_size / 1024
    print(f"  ! {out.name} is {size_kb:.0f} KB, above the {max_kb} KB limit")
    print("    Shorten it, or lower the frame rate.")


def find_ground(frame: Image.Image) -> int | None:
    """Return the row where the ground begins, or None if no edge is clear.

    The ground is warmer than the background and, unlike the character, it
    spans the whole width. So this walks up from the bottom while the row stays
    warm right across, and returns the first row that does. Looking for the
    largest warmth jump instead finds the character, which is warmer still.
    """
    pixels = frame.load()

    def warmth(y: int) -> int:
        # The median ignores the confetti that lands on the ground. Counting
        # warm pixels instead lets a few cool specks break the row, which made
        # each frame detect a different ground line. It also ignores the
        # character, which is far warmer than the ground it stands on.
        row = sorted(pixels[x, y][0] - pixels[x, y][2] for x in range(0, SIZE, 4))
        return row[len(row) // 2]

    # Measure against this clip's own sky. One recording has a strongly tinted
    # ground and another only a pale one, so no fixed threshold suits both.
    sky = warmth(4)
    floor_level = sky + 4

    def warm_across(y: int) -> bool:
        return warmth(y) >= floor_level

    # Find the lowest warm row first. The ground does not always reach the
    # bottom edge: one recording has page whitespace below it.
    y = SIZE - 1
    while y >= SIZE // 3 and not warm_across(y):
        y -= 1
    if y < SIZE // 3:
        return None

    # then walk up to the top edge of that band
    while y > SIZE // 3 and warm_across(y - 1):
        y -= 1
    return y


def align_ground(frames: list[Image.Image], target: int) -> list[Image.Image]:
    """Shift the whole clip so its ground line sits on the given row.

    One shift for the clip, not one per frame. Detection wobbles by a pixel or
    two between frames, and correcting each frame separately turns that wobble
    into visible jitter. Worse, a per-frame shift would cancel the vertical
    motion the animation intends, such as a jump.
    """
    found = [y for y in (find_ground(f) for f in frames) if y is not None]
    if not found:
        print("  ! could not find a ground line, leaving the clip where it is")
        return frames

    found.sort()
    ground = found[len(found) // 2]  # median, so odd frames cannot skew it
    offset = target - ground
    if offset == 0:
        print(f"  Ground already at y={target}")
        return frames

    sky = frames[0].getpixel((4, 4))
    shifted = []
    for frame in frames:
        canvas = Image.new("RGB", (SIZE, SIZE), sky)
        canvas.paste(frame, (0, offset))
        shifted.append(canvas)

    print(
        f"  Ground found at y={ground} in {len(found)} of {len(frames)} frames, "
        f"moved the clip by {offset:+d} to y={target}"
    )
    return shifted


def fit_square(frame: Image.Image) -> Image.Image:
    """Centre-crop to a square, then resize to the display size."""
    w, h = frame.size
    side = min(w, h)
    left = (w - side) // 2
    top = (h - side) // 2
    cropped = frame.crop((left, top, left + side, top + side))
    return cropped.resize((SIZE, SIZE), Image.LANCZOS)


# ---------------------------------------------------------------------------
# pack
# ---------------------------------------------------------------------------
def load_video_frames(src: Path, start: float, seconds: float, fps: int) -> list:
    """Pull frames out of a video with ffmpeg."""
    if not shutil.which("ffmpeg"):
        print("Error: ffmpeg is not installed. Run: brew install ffmpeg")
        sys.exit(1)

    with tempfile.TemporaryDirectory() as tmp:
        cmd = ["ffmpeg", "-y", "-v", "error"]
        if start:
            cmd += ["-ss", str(start)]
        cmd += ["-i", str(src)]
        if seconds:
            cmd += ["-t", str(seconds)]
        cmd += ["-vf", f"fps={fps}", str(Path(tmp) / "f%04d.png")]

        result = subprocess.run(cmd)
        if result.returncode != 0:
            print("Error: ffmpeg could not read that file.")
            sys.exit(1)

        files = sorted(Path(tmp).glob("f*.png"))
        return [Image.open(f).convert("RGB").copy() for f in files]


def cmd_pack(args: argparse.Namespace) -> None:
    """Convert an image, GIF, or video into the library."""
    src = Path(args.input).expanduser()
    if not src.exists():
        print(f"Error: {src} does not exist.")
        sys.exit(1)

    video_suffixes = {".mp4", ".mov", ".m4v", ".webm", ".mkv", ".avi"}
    if src.suffix.lower() in video_suffixes:
        frames = load_video_frames(src, args.start, args.seconds, args.fps)
    else:
        image = Image.open(src)
        frames = []
        starts = []  # when each frame appears, in seconds
        clock = 0.0
        for frame in ImageSequence.Iterator(image):
            frames.append(frame.convert("RGB").copy())
            starts.append(clock)
            clock += frame.info.get("duration", 100) / 1000.0

        if args.start or args.seconds:
            until = args.start + args.seconds if args.seconds else clock
            kept = [
                f for f, at in zip(frames, starts) if args.start <= at < until
            ]
            if kept:
                print(
                    f"  Trimmed to {args.start:g}s..{until:g}s "
                    f"({len(kept)} of {len(frames)} frames)"
                )
                starts = [
                    at - args.start for at in starts if args.start <= at < until
                ]
                frames = kept
            else:
                print(f"  ! nothing between {args.start:g}s and {until:g}s")
                sys.exit(1)

        # Resample to the requested rate. Without this the source rate is kept
        # and the size search thins the frames instead, which slows playback.
        span = args.seconds if args.seconds else clock - args.start
        if span > 0 and len(frames) > 1:
            wanted = max(2, int(round(span * args.fps)))
            if wanted < len(frames):
                picked = []
                for i in range(wanted):
                    target = i * span / wanted
                    nearest = min(range(len(starts)), key=lambda j: abs(starts[j] - target))
                    picked.append(frames[nearest])
                print(f"  Resampled {len(frames)} frames to {len(picked)} at {args.fps} fps")
                frames = picked

    if not frames:
        print("Error: no frames found in that file.")
        sys.exit(1)

    # A screen recording often opens or closes on a frame where the page is
    # still settling. Such a frame flashes on every loop.
    if args.drop_first or args.drop_last:
        end = len(frames) - args.drop_last if args.drop_last else len(frames)
        trimmed = frames[args.drop_first : end]
        if len(trimmed) < 2:
            print("  ! that would leave fewer than two frames")
            sys.exit(1)
        print(
            f"  Dropped {args.drop_first} from the start and "
            f"{args.drop_last} from the end ({len(trimmed)} frames left)"
        )
        frames = trimmed

    frames = [fit_square(f) for f in frames]

    # Stabilise the horizon first, so the floor fill below lands on a ground
    # line that no longer moves between frames.
    if args.align_ground:
        frames = align_ground(frames, args.align_ground)

    # Paint the ground as one solid block. A recording of a page often leaves
    # stray animation pixels below the ground line, and a flat block hides them
    # and compresses better than the speckle it replaces.
    if args.floor:
        line = max(0, min(SIZE - 1, args.floor))
        if args.floor_color:
            text = args.floor_color.lstrip("#")
            ground = tuple(int(text[i : i + 2], 16) for i in (0, 2, 4))
        else:
            probe = frames[0].crop(
                (0, min(SIZE - 1, line + 3), SIZE, min(SIZE, line + 4))
            )
            counts = probe.getcolors(SIZE * 4) or [(1, (200, 190, 175))]
            ground = max(counts)[1]
        print(f"  Ground filled from y={line} with rgb{ground}")
        for frame in frames:
            ImageDraw.Draw(frame).rectangle([0, line, SIZE, SIZE], fill=ground)

    out = library_path(args.name)
    print(f"Packing {src.name} -> {out}")
    save_frames(frames, out, args.fps, args.max_kb)


# ---------------------------------------------------------------------------
# extract
# ---------------------------------------------------------------------------
def cmd_extract(args: argparse.Namespace) -> None:
    """Recover a GIF that an app embeds as a C byte array."""
    src = Path(args.header).expanduser()
    if not src.exists():
        print(f"Error: {src} does not exist.")
        sys.exit(1)

    text = src.read_text()
    body = text[text.index("{") + 1 : text.rindex("}")]
    data = bytes(int(b, 16) for b in re.findall(r"0x([0-9a-fA-F]{2})", body))

    if not data.startswith(b"GIF8"):
        print("Error: that header does not hold GIF data.")
        sys.exit(1)

    out = library_path(args.name)
    out.write_bytes(data)
    print(f"Extracted {out} ({len(data) / 1024:.0f} KB)")

    with Image.open(out) as image:
        print(f"  {image.size[0]}x{image.size[1]}, {image.n_frames} frames")
        if image.size != (SIZE, SIZE):
            print(f"  ! not {SIZE}x{SIZE} — run 'gifpack pack' on it")
    if len(data) / 1024 > args.max_kb:
        print(f"  ! {len(data) / 1024:.0f} KB is above the {args.max_kb} KB limit")
        print(f"    Repack it: ./tools/gifpack pack {out} {args.name}")


# ---------------------------------------------------------------------------
# mascot
# ---------------------------------------------------------------------------
# The figure is anchored so it never drifts: feet on BASE_Y, centred on CX.
CX = 120.0
BASE_Y = 192.0
BODY_W, BODY_H = 118.0, 96.0
LEG_W, LEG_H = 22.0, 52.0
HAND_W, HAND_H = 24.0, 36.0
EYE_W, EYE_H = 18.0, 26.0

# Rendering happens at this multiple and is then reduced, so rotated edges come
# out smooth instead of stepped.
SUPERSAMPLE = 4


def new_frame() -> tuple:
    """Return an oversized frame and its drawing context."""
    frame = Image.new(
        "RGB", (SIZE * SUPERSAMPLE, SIZE * SUPERSAMPLE), BG
    )
    return frame, ImageDraw.Draw(frame)


def finish(frame: Image.Image) -> Image.Image:
    """Reduce an oversized frame to the display size."""
    return frame.resize((SIZE, SIZE), Image.LANCZOS)


def block(
    draw: ImageDraw.ImageDraw,
    ax: float,
    ay: float,
    w: float,
    h: float,
    color: tuple,
    angle: float = 0.0,
    anchor: str = "top",
) -> None:
    """Draw a rectangle, optionally rotated about its top edge or its centre.

    Limbs rotate about the top, which is how a leg swings from the hip.
    """
    rad = math.radians(angle)
    ca, sa = math.cos(rad), math.sin(rad)

    if anchor == "top":
        corners = [(-w / 2, 0.0), (w / 2, 0.0), (w / 2, h), (-w / 2, h)]
    else:
        corners = [
            (-w / 2, -h / 2),
            (w / 2, -h / 2),
            (w / 2, h / 2),
            (-w / 2, h / 2),
        ]

    points = []
    for dx, dy in corners:
        rx = dx * ca - dy * sa
        ry = dx * sa + dy * ca
        points.append(((ax + rx) * SUPERSAMPLE, (ay + ry) * SUPERSAMPLE))
    draw.polygon(points, fill=color)


def draw_mascot(
    draw: ImageDraw.ImageDraw,
    lift: float = 0.0,
    tilt: float = 0.0,
    leg_swing: tuple = (0.0, 0.0, 0.0, 0.0),
    leg_stretch: tuple = (1.0, 1.0, 1.0, 1.0),
    arm_left: float = 0.0,
    arm_right: float = 0.0,
    eye_shift: float = 0.0,
    eye_drop: float = 0.0,
    body_color: tuple = CLAY,
) -> None:
    """Draw the mascot from rectangles.

    lift raises the whole figure, tilt leans the body, leg_swing rotates each
    leg from its hip and leg_stretch scales its length, and arm_left and
    arm_right rotate each hand from the shoulder.
    """
    hip_y = BASE_Y - LEG_H - lift
    body_bottom = hip_y + 4
    body_top = body_bottom - BODY_H

    # Legs, drawn first so the body block covers their tops.
    gap = (BODY_W - 4 * LEG_W) / 3
    for i in range(4):
        hip_x = CX - BODY_W / 2 + LEG_W / 2 + i * (LEG_W + gap)
        block(
            draw,
            hip_x,
            hip_y,
            LEG_W,
            LEG_H * leg_stretch[i],
            CLAY_DARK,
            angle=leg_swing[i],
        )

    # Hands swing from a shoulder on the body edge, so they stay attached when
    # the arm rotates instead of drifting away from the body.
    shoulder_y = body_top + 30
    block(
        draw,
        CX - BODY_W / 2 + 3,
        shoulder_y,
        HAND_W,
        HAND_H,
        CLAY_DARK,
        angle=arm_left,
    )
    block(
        draw,
        CX + BODY_W / 2 - 3,
        shoulder_y,
        HAND_W,
        HAND_H,
        CLAY_DARK,
        angle=arm_right,
    )

    # Body block, leaning from its base.
    block(
        draw,
        CX,
        body_bottom,
        BODY_W,
        -BODY_H,
        body_color,
        angle=tilt,
        anchor="top",
    )

    # Eyes shift position rather than change shape.
    eye_y = body_top + 22 + eye_drop
    for side in (-1, 1):
        ex = CX + side * 23 + eye_shift
        block(draw, ex, eye_y, EYE_W, EYE_H, EYE, angle=tilt)


def make_hello() -> list:
    """Idle bob, with the eyes looking about."""
    frames = []
    count = 24
    for i in range(count):
        t = i / count
        frame, draw = new_frame()
        draw_mascot(
            draw,
            lift=2 + math.sin(t * 2 * math.pi) * 3,
            tilt=math.sin(t * 2 * math.pi) * 2.5,
            eye_shift=math.sin(t * 2 * math.pi) * 4,
            arm_left=math.sin(t * 2 * math.pi) * 6,
            arm_right=-math.sin(t * 2 * math.pi) * 6,
        )
        frames.append(finish(frame))
    return frames


def make_wave() -> list:
    """One hand swings up and waves."""
    frames = []
    count = 24
    for i in range(count):
        t = i / count
        frame, draw = new_frame()
        raise_arm = min(1.0, t * 4)
        wave = math.sin(t * 6 * math.pi) * 22 * raise_arm
        draw_mascot(
            draw,
            lift=1 + math.sin(t * 4 * math.pi) * 2,
            tilt=-3 * raise_arm,
            arm_right=-150 * raise_arm + wave,
            arm_left=8,
            eye_shift=3,
        )
        frames.append(finish(frame))
    return frames


def make_walk() -> list:
    """A walk cycle: legs swing from the hip and stretch as they reach."""
    frames = []
    count = 20
    for i in range(count):
        t = i / count
        frame, draw = new_frame()
        phase = t * 2 * math.pi
        swings = tuple(math.sin(phase + k * math.pi / 2) * 17 for k in range(4))
        stretch = tuple(
            0.88 + 0.16 * (0.5 + 0.5 * math.cos(phase + k * math.pi / 2))
            for k in range(4)
        )
        draw_mascot(
            draw,
            lift=abs(math.sin(phase)) * 4,
            tilt=math.sin(phase) * 3,
            leg_swing=swings,
            leg_stretch=stretch,
            arm_left=math.sin(phase) * 20,
            arm_right=-math.sin(phase) * 20,
            eye_shift=4,
        )
        frames.append(finish(frame))
    return frames


def make_thinking() -> list:
    """Looks around while three blocks fill in turn."""
    frames = []
    count = 24
    for i in range(count):
        t = i / count
        frame, draw = new_frame()
        look = math.sin(t * 2 * math.pi) * 6
        draw_mascot(
            draw,
            lift=1,
            tilt=look * 0.6,
            arm_left=-40,
            eye_shift=look,
            eye_drop=2,
        )
        for d in range(3):
            lit = (i // 4) % 3 == d
            x = CX - 30 + d * 24
            size = 13 if lit else 8
            color = CLAY_LIGHT if lit else CLAY_DARK
            block(draw, x, 196, size, size, color, anchor="centre")
        frames.append(finish(frame))
    return frames


def make_done() -> list:
    """A hop, and a tick that draws itself."""
    frames = []
    count = 24
    steps = [(92, 194), (101, 203), (110, 212), (121, 199), (132, 186), (143, 173)]
    for i in range(count):
        t = i / count
        frame, draw = new_frame()
        hop = 20 * max(0.0, math.sin(min(t * 2.2, 1.0) * math.pi))
        draw_mascot(
            draw,
            lift=hop + 26,
            tilt=0,
            arm_left=25,
            arm_right=-25,
            leg_stretch=(0.9, 0.9, 0.9, 0.9),
        )
        shown = int(max(0.0, (t - 0.30) / 0.45) * len(steps))
        for x, y in steps[:shown]:
            block(draw, x, y, 12, 12, (120, 214, 140), anchor="centre")
        frames.append(finish(frame))
    return frames


def make_oops() -> list:
    """A shake, and the body turns amber."""
    frames = []
    count = 20
    for i in range(count):
        t = i / count
        frame, draw = new_frame()
        shake = math.sin(t * 8 * math.pi)
        draw_mascot(
            draw,
            lift=0,
            tilt=shake * 9,
            arm_left=-shake * 16,
            arm_right=-shake * 16,
            eye_shift=-shake * 5,
            eye_drop=3,
            body_color=AMBER,
        )
        frames.append(finish(frame))
    return frames


def make_celebrate() -> list:
    """A bounce under falling confetti blocks."""
    frames = []
    count = 24
    confetti = [(14 + (k * 41) % 214, (k * 57) % 240, k % 4) for k in range(20)]
    palette = [CLAY_LIGHT, AMBER, (120, 214, 140), (238, 238, 238)]
    for i in range(count):
        t = i / count
        frame, draw = new_frame()
        for x, y0, tone in confetti:
            y = (y0 + t * 120) % 264 - 12
            size = 7 + (tone % 2) * 4
            block(draw, x, y, size, size, palette[tone], angle=tone * 18,
                  anchor="centre")
        bounce = 18 * abs(math.sin(t * 2 * math.pi))
        draw_mascot(
            draw,
            lift=bounce,
            tilt=math.sin(t * 4 * math.pi) * 4,
            arm_left=40 + bounce,
            arm_right=-40 - bounce,
            leg_stretch=(0.92, 1.0, 1.0, 0.92),
        )
        frames.append(finish(frame))
    return frames


MASCOTS = {
    "hello": make_hello,
    "wave": make_wave,
    "walk": make_walk,
    "thinking": make_thinking,
    "done": make_done,
    "oops": make_oops,
    "celebrate": make_celebrate,
}


def cmd_mascot(args: argparse.Namespace) -> None:
    """Draw the mascot set into the library."""
    names = args.only or list(MASCOTS)
    print(f"Drawing mascot animations into {LIBRARY}")
    for name in names:
        if name not in MASCOTS:
            print(f"  ! unknown mascot '{name}'")
            continue
        frames = MASCOTS[name]()
        save_frames(frames, library_path(name), args.fps, args.max_kb)


# ---------------------------------------------------------------------------
# list
# ---------------------------------------------------------------------------
def cmd_list(_args: argparse.Namespace) -> None:
    """Show what the library holds."""
    if not LIBRARY.exists():
        print(f"No library at {LIBRARY}. Run './tools/gifpack mascot' to start one.")
        return

    files = sorted(LIBRARY.glob("*.gif"))
    if not files:
        print(f"{LIBRARY} holds no GIFs.")
        return

    print(f"{LIBRARY}:")
    for path in files:
        size_kb = path.stat().st_size / 1024
        try:
            with Image.open(path) as image:
                detail = f"{image.size[0]}x{image.size[1]}, {image.n_frames} frames"
        except OSError:
            detail = "unreadable"
        flag = "  ok" if size_kb <= DEFAULT_MAX_KB else "  TOO BIG"
        print(f"  {path.stem:<16} {size_kb:>6.0f} KB  {detail}{flag}")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def main() -> None:
    parser = argparse.ArgumentParser(
        prog="gifpack",
        description="Prepare GIFs for the Kublet and keep them in a library.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
examples:
  ./tools/gifpack mascot
  ./tools/gifpack pack clip.mp4 wave --start 91 --seconds 20
  ./tools/gifpack extract apps/badgers/src/badgers.h badgers
  ./tools/gifpack list
        """,
    )
    parser.add_argument(
        "--max-kb",
        type=int,
        default=DEFAULT_MAX_KB,
        help=f"Size limit in KB (default: {DEFAULT_MAX_KB})",
    )
    parser.add_argument(
        "--fps", type=int, default=DEFAULT_FPS, help=f"Default: {DEFAULT_FPS}"
    )
    subparsers = parser.add_subparsers(dest="command", title="commands")

    p_pack = subparsers.add_parser("pack", help="Convert media into the library")
    p_pack.add_argument("input", help="Image, GIF, or video file")
    p_pack.add_argument("name", help="Library name, for example wave")
    p_pack.add_argument(
        "--start", type=float, default=0.0, help="Video start time in seconds"
    )
    p_pack.add_argument(
        "--seconds", type=float, default=0.0, help="Length to take from a video"
    )
    p_pack.add_argument(
        "--drop-first",
        type=int,
        default=0,
        dest="drop_first",
        help="Drop this many frames from the start, for a settling first frame",
    )
    p_pack.add_argument(
        "--drop-last",
        type=int,
        default=0,
        dest="drop_last",
        help="Drop this many frames from the end",
    )
    p_pack.add_argument(
        "--floor",
        type=int,
        default=0,
        help="Fill from this row down with the ground colour, hiding stray pixels",
    )
    p_pack.add_argument(
        "--floor-color",
        default="",
        dest="floor_color",
        help="Ground colour as #RRGGBB. Use the same value across clips so "
        "their ground matches. Sampled from the clip when omitted.",
    )
    p_pack.add_argument(
        "--align-ground",
        type=int,
        default=0,
        dest="align_ground",
        help="Shift each frame so the ground line sits on this row. Use the "
        "same value across clips to give them a common horizon.",
    )

    p_extract = subparsers.add_parser(
        "extract", help="Recover a GIF from an app's C array"
    )
    p_extract.add_argument("header", help="Path to the .h file")
    p_extract.add_argument("name", help="Library name")

    p_mascot = subparsers.add_parser("mascot", help="Draw the mascot set")
    p_mascot.add_argument(
        "only", nargs="*", help=f"Which ones to draw ({', '.join(MASCOTS)})"
    )

    subparsers.add_parser("list", help="Show what the library holds")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)

    commands = {
        "pack": cmd_pack,
        "extract": cmd_extract,
        "mascot": cmd_mascot,
        "list": cmd_list,
    }
    commands[args.command](args)


main()
